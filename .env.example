# ─────────────────────────────────────────────
# Anthropic — análise de conteúdo e geração de texto
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─────────────────────────────────────────────
# Explorium / Vibe Prospecting — busca de empresas
# Deixe em branco para usar dados mock de demonstração
# ─────────────────────────────────────────────
EXPLORIUM_API_KEY=

# ─────────────────────────────────────────────
# Gmail OAuth2
# 1. Acesse https://console.cloud.google.com/
# 2. Crie um projeto > APIs & Services > Credentials
# 3. OAuth 2.0 Client ID (tipo: Desktop app)
# 4. Baixe o JSON e salve como credentials/gmail_credentials.json
# ─────────────────────────────────────────────
GMAIL_REMETENTE=seuemail@gmail.com

# ─────────────────────────────────────────────
# Bloco Produções — identidade usada nas apresentações
# ─────────────────────────────────────────────
BLOCO_BIO="A Bloco Produções é uma produtora audiovisual sediada no Sul do Brasil, especializada em vídeos institucionais, reels, cases de sucesso, cobertura de eventos e conteúdo para redes sociais. Com mais de X anos de mercado, atendemos marcas que querem transformar sua comunicação em experiências visuais memoráveis."
